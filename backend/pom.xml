<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.district360</groupId>
    <artifactId>district360-backend</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>
    <name>District 360 backend</name>

    <modules>
        <module>d360-common</module>
        <module>d360-stat</module>
        <module>d360-makani</module>
        <module>d360-liveability</module>
        <module>d360-adrec</module>
        <module>d360-ods</module>
        <module>d360-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.district360</groupId>
                <artifactId>d360-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.district360</groupId>
                <artifactId>d360-stat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.district360</groupId>
                <artifactId>d360-makani</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.district360</groupId>
                <artifactId>d360-liveability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.district360</groupId>
                <artifactId>d360-adrec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.district360</groupId>
                <artifactId>d360-ods</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
