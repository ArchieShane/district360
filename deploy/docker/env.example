# docker-compose 读取的变量（打包时复制为部署目录下的 .env）。改完执行 ./start.sh 重建容器生效。

# 镜像名（docker load 后的名字，一般不用改）
D360_IMAGE=district360:1.0

# 宿主机端口：前端页面和接口共用这一个端口
D360_HOST_PORT=8360

# 二级路由：页面地址 http://<服务器>:<端口>/district360/ ，接口 /district360/api/v1/...
# 改名只改这里，不用重新打包前端；必须以 / 开头、末尾不带 /。挂在根路径时留空：D360_CONTEXT_PATH=
D360_CONTEXT_PATH=/district360

# JVM 参数：makani 抽取时会把 38 万栋建筑、41 万个地块读进内存，建议最大堆不低于 2g
JAVA_OPTS=-Xms512m -Xmx2g

TZ=Asia/Dubai
